+
+        if (!is_int($studentId) || $studentId < 1 || !is_bool($completed)) {
+            $fail(422, 'Invalid request.');
+            return;
+        }
+
+        if (!is_array($subtopicIds) || $subtopicIds === [] || count($subtopicIds) > 300) {
+            $fail(422, 'Invalid subtopics.');
