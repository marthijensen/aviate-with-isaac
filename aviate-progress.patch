+        $expectedToken = $_SESSION['progress_csrf'] ?? '';
+
+        if (
+            !is_string($submittedToken)
+            || !is_string($expectedToken)
+            || $expectedToken === ''
+            || !hash_equals($expectedToken, $submittedToken)
+        ) {
