SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APP_TIMEZONE=America/Denver

# Read-only PostgreSQL connection
READONLY_DB_HOST=
READONLY_DB_PORT=5432
READONLY_DB_NAME=postgres
READONLY_DB_USER=
READONLY_DB_PASSWORD=

# Restricted PostgreSQL writer
WRITE_DB_HOST=
WRITE_DB_PORT=5432
WRITE_DB_NAME=postgres
WRITE_DB_USER=
WRITE_DB_PASSWORD=

# Enable only for authorized local testing
AVIATE_LOCAL_WRITES=0