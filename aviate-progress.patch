+
+            $statement->execute(['student_id' => $studentId]);
+            $courseId = $statement->fetchColumn();
+
+            if ($courseId === false || $courseId === null) {
+                $fail(404, 'Student not found or not enrolled in a course.');
+                return;
+            }
+
+            $valid = [];
+
+            foreach (TrainingProgress::syllabus($db, (int) $courseId) as $topic) {
+                foreach ($topic['subtopics'] as $subtopic) {
+                    $valid[$subtopic['id']] = true;
+                }
+            }
+
+            foreach ($subtopicIds as $subtopicId) {
+                if (!isset($valid[$subtopicId])) {
+                    $fail(422, 'Unknown subtopic for this student.');
+                    return;
+                }
+            }
+
+            // All ids are validated integers, so this literal is safe to bind as an array.
